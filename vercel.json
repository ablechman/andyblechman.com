{
  "redirects": [
    {
      "source": "/coming-soon",
      "has": [{ "type": "host", "value": "blog.andyblechman.com" }],
      "destination": "https://andyblechman.com/blog/sohohouseforathletes",
      "permanent": true
    },
    {
      "source": "/rss/",
      "has": [{ "type": "host", "value": "blog.andyblechman.com" }],
      "destination": "https://andyblechman.com/rss.xml",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "blog.andyblechman.com" }],
      "destination": "https://andyblechman.com/blog/:path*",
      "permanent": true
    },
    {
      "source": "/blog/coming-soon",
      "destination": "/blog/sohohouseforathletes",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
